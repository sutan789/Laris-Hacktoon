<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan proses file/folder yang memang ada di root (aset statis)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan semua request ke laris_app/public/
    RewriteRule ^(.*)$ laris_app/public/$1 [L]
</IfModule>
